[sub_resource type="Shader" id="Shader_f2t0a"]
code = "shader_type canvas_item;

uniform sampler2D SCREEN_TEXTURE : hint_screen_texture, filter_linear_mipmap;
uniform float blur_strength = 4.0;

void fragment() {
    vec2 uv = SCREEN_UV;
    
    vec4 col = vec4(0.0);
    
    col += texture(SCREEN_TEXTURE, uv + vec2(-0.002, 0.0));
    col += texture(SCREEN_TEXTURE, uv + vec2(0.002, 0.0));
    col += texture(SCREEN_TEXTURE, uv + vec2(0.0, -0.002));
    col += texture(SCREEN_TEXTURE, uv + vec2(0.0, 0.002));
    
    col /= 4.0;

    // Glass tint
    col.rgb += vec3(0.1, 0.1, 0.1);
    col.a = 0.6;

    COLOR = col;
}
"

